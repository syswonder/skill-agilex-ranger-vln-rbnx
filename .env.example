# Copy to .env. Never commit the resulting .env file.

# ---- Ranger chassis CAN (optional; defaults are the Ranger Mini v3 values) ----
# This stack owns the can_ranger bus. It must not run at the same time as the
# navigation stack. Override only if this host uses a different CAN name.
# RANGER_CAN_INTERFACE=can_ranger
# RANGER_CAN_BITRATE=500000

# ---- InternVLA-N1 (DualVLN) model server -- REQUIRED ----
# The BASE url of the compute host's inference service.  What that host runs is
# upstream's scripts/realworld/http_internvla_server.py, and it publishes exactly
# one route: POST /eval_dual.  There is no /health, no /task/start and no
# /task/report -- neither in the upstream file nor in the two local deployment
# documents (internVLN/InternVLA-N1-DualVLN-部署文档.md,
# internVLN/InternVLA-N1 AGX Orin 推理部署记录.md).  The request wire format is
# the one in internVLN/vln_query.py: a `json` form field carrying
# {"reset": bool, "instruction": str} plus one JPEG part named "image".
#
# The client appends /eval_dual itself, so do NOT include an endpoint path here.
# Loopback is correct only when the server is tunneled onto this machine.
#
# start.sh probes <url>/eval_dual with a GET before booting and refuses to arm a
# live stack when there is no answer, so a typo here fails in five seconds
# instead of looking like a policy that has stopped working.
INTERNVLA_SERVER_URL=http://127.0.0.1:5801

# SECURITY: that server has no authentication and binds 0.0.0.0.  Scope any
# firewall rule to the robot/AGX subnet -- never 0.0.0.0/0.  Anyone who can
# reach it can drive the robot.

# ---- Server-side knobs you may need to keep in step ----
# The server's own flags are set on the compute host, not here, but two of them
# change what this side must do:
#   --resize_w / --resize_h   the server resizes, so model_crop_size in the
#                             manifest must match (384) or the framing silently
#                             shifts and the actions degrade with no error
#   --num_history             frames of history per evaluation; a high value
#                             makes a startup burst of frames matter
#   (the flags above are the ones upstream's script actually takes; it also
#    takes --device and --model_path.  How many calls skip the planner is what
#    sets the achievable action rate, and therefore the smallest sane
#    plan_hold_s in the manifest -- measure it, do not assume it.)

# ---- Instruction overrides (optional) ----
# Normally the instruction is set at runtime, over
# robonix/primitive/vln/task or the ROS topic /ranger/vln/instruction.
# Changing the manifest's `instruction:` is the boot-time default only.
# INTERNVLA_INSTRUCTION=Go to the chair and stop.

# ---- Tencent Cloud speech (voice only; not on the command path) ----
# The speech service (ASR for spoken instructions, TTS for replies) and the
# audio_client_bridge primitive are in the manifest; these credentials are read
# from this environment and are never written into the manifest.  Copy them
# from the follow stack's .env if that stack is already configured on this
# robot.  Leave them empty and everything else still works -- voice alone
# fails, and the base is unaffected.
TENCENT_ASR_APPID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
